# Emanet ayarları. Sunucuda: umask 077 && cp .env.example .env
# MCP erişim anahtarları (virgülle, her biri en az 24 karakter). Boşsa /mcp kapalıdır.
#   Üret: openssl rand -hex 32    Claude'da bağlayıcı adresi: https://emanet.ysfdurak.com/mcp/<anahtar>
EMANET_MCP_ANAHTARLARI=
# IP başına dakikada yazma ve toplam istek sınırı
EMANET_ISTEK_SINIRI=40
EMANET_OKUMA_SINIRI=300
# Ziyaretçi demosu: her ziyaretçiye ayrı veri kopyası (1). Şirket içi tek ekip kurulumunda 0.
EMANET_ZIYARETCI=1
# Kendi verinle kurulumda: EMANET_DB=/veri/yerel.db
# Çerezde Secure bayrağı (HTTPS). Yalnız yerel ağda http üzerinden denerken 0.
EMANET_GUVENLI_CEREZ=1
